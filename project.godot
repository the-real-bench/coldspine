; COLDSPINE — Godot 4.7 project
; Engine decision: Godot 4.x / GDScript (GDD §17.0). The game runs on its OWN
; deterministic integer sim (res://core), NOT Godot's physics engine.

config_version=5

[application]

config/name="COLDSPINE"
config/description="Squad-based, physics-first turn-based tactical roguelite aboard a globe-circling train."
config/version="0.1.0"
config/features=PackedStringArray("4.7")
run/main_scene="res://app/menu.tscn"
config/icon="res://assets/icon.svg"

; W7-4 — the window title IS config/name ("COLDSPINE"), so the OS titlebar reads the game name, not a
; default project string. A branded BOOT SPLASH also replaces the stock Godot-logo splash: the app mark
; centered on the near-black ART_BIBLE FRAME_BG (#0B0E11). Swap boot_splash/image for the final title /
; boot key art when it lands (see docs/art/ART_SHOPPING_LIST.md §8).
boot_splash/bg_color=Color(0.043, 0.055, 0.067, 1)
boot_splash/image="res://assets/icon.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/show_image=true

[autoload]

SessionLog="*res://app/session_log.gd"
AudioDirector="*res://app/audio_director.gd"

[audio]

; COLDSPINE bus layout (release-readiness #4): Master -> Music / SFX / UI. The AudioDirector
; autoload routes event-driven SFX onto these buses and drives Music/SFX volume from the
; settings sliders. Silent + byte-identical headless (the director no-ops without a display).
buses/default_bus_layout="res://default_bus_layout.tres"

[display]

; Orientation 4 = SENSOR_LANDSCAPE: the whole UI is a hand-positioned 1280x720 LANDSCAPE layout
; (run_screens/ops_hud/menu bake those dimensions), so a handheld build must never boot portrait.
; aspect "keep" letterboxes non-16:9 displays so the hardcoded layout is exactly what renders —
; the LOUD honest choice until a real portrait/responsive reflow is built (owner backlog #5).
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
